  "version": "0.1.0",
  "description": "Backyard Monsters Refitted: the Inferno MR2 game for the browser (TypeScript)",
  "type": "module",
  "scripts": {
    "build": "tsx tools/build.ts",
    "stamp": "tsx tools/stamp-build.ts",
