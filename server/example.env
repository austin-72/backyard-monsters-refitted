# Visit our Wiki to get more information about our environment variables.
# Wiki: https://github.com/bym-refitted/backyard-monsters-refitted/wiki/Server-&-Database-Setup

# Base URLs
BASE_URL=http://localhost
CDN_URL=  # Required when USE_VERSION_MANAGEMENT is enabled

# Server
PORT=3001
SECRET_KEY=
SESSION_LIFETIME=30d
ENV=local

# Docker-specific ports (these map to your host machine)
API_PORT=3001

# Uncomment if you have a local PostgreSQL install conflicting on port 5432
# DB_HOST_PORT=5433

# Database
DB_NAME='bym'
DB_HOST='localhost'
DB_PORT=5432
DB_USER='postgres'
DB_PASSWORD='dev12345'

# Automatic database backups (the "backup" service; RUNNING-INFERNO-ONLY.md, "Backups")
# Where they go. Default: server\backups. A folder OneDrive (or Google Drive) syncs keeps a copy off
# this computer, e.g. C:/Users/YOU/OneDrive/bymr-backups
# BACKUP_DIR=./backups
# Hour of the day (0-23, in TZ) to back up at
# BACKUP_HOUR=4
# BACKUP_KEEP_DAYS=14
# BACKUP_KEEP_WEEKS=8
# BACKUP_KEEP_MONTHS=12
# TZ=America/Chicago

# pgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=8080

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Chat WebSocket server
CHAT_WS_PORT=3010
CHAT_WS_HOST=localhost:3010

# Ports the Flash socket policy authorises (comma-separated, or a range).
# Only set this where several environments share a host: whichever process
# binds port 843 answers for all of them, so it must list every chat port.
# Defaults to CHAT_WS_PORT.
# CHAT_POLICY_PORTS=3010,3011

# Switches
USE_VERSION_MANAGEMENT='disabled'

# Website
WEB_URL=https://bymrefitted.com

# Discord
DISCORD_TOKEN=

# Mail server
SMTP_HOST=127.0.0.1
SMTP_PORT=    
SMTP_USER=
SMTP_PASSWORD=